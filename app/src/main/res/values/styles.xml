<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KartingPanelCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/karting_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/karting_panel</item>
    </style>

    <style name="KartingPanelCard.Emphasis" parent="KartingPanelCard">
        <item name="cardBackgroundColor">@color/karting_panel_alt</item>
        <item name="strokeColor">@color/karting_stroke_strong</item>
    </style>

    <style name="KartingSectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/karting_text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="KartingBodyMuted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/karting_text_secondary</item>
    </style>

    <style name="KartingButton.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/karting_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="KartingButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/karting_stroke_strong</item>
        <item name="android:textColor">@color/karting_text_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="KartingButton.Quick" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/karting_surface_tint</item>
        <item name="android:textColor">@color/karting_text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
