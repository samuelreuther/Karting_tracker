<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KartingPanelCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/premium_corner</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/karting_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/karting_panel</item>
    </style>

    <style name="KartingPanelCard.Emphasis" parent="KartingPanelCard">
        <item name="cardBackgroundColor">@color/karting_panel_alt</item>
    </style>

    <style name="KartingSectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/karting_text_primary</item>
    </style>

    <style name="KartingBodyMuted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/karting_text_secondary</item>
    </style>
</resources>
